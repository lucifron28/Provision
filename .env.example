# PostgreSQL 18 Local Development (Docker Compose)
POSTGRES_USER=provision
POSTGRES_PASSWORD=provision
POSTGRES_DB=provision
POSTGRES_PORT=5432

# Backend Database URL (FastAPI connects via localhost)
DATABASE_URL=postgresql+psycopg://provision:provision@127.0.0.1:5432/provision

# JWT Authentication (generate a secure random key for local development)
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
