PROJECT_NAME="Provision Household Inventory API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# PostgreSQL Database (Docker Compose on localhost)
DATABASE_URL="postgresql+psycopg://provision:provision@127.0.0.1:5432/provision"

# JWT Authentication settings
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Placeholder only. Live DeepSeek and web search remain disabled.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
