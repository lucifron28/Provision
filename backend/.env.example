PROJECT_NAME="Provision Household Inventory API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
# Default SQLite database (file created locally)
DATABASE_URL="sqlite:///./provision.db"
# Example PostgreSQL database:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/provision"

# JWT Authentication settings
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
